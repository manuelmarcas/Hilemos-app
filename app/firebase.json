{
  "hosting": [
    {
      "target": "app",
      "public": "dist",
      "ignore": [
        "**/*.map",
        "**/.DS_Store",
        "**/.gitkeep"
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/firebase-messaging-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "antigua",
      "public": "redirect",
      "redirects": [
        {
          "regex": "^/(.*)$",
          "destination": "https://hilemos.web.app/:1",
          "type": 301
        }
      ]
    }
  ]
}
