{
  "name": "votaciones-app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting:app",
    "android": "tsc --noEmit && vite build --mode android && cap sync android",
    "android:open": "cap open android",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor \"#5E2A59\" --iconBackgroundColorDark \"#5E2A59\" --splashBackgroundColor \"#f6f4f7\" --splashBackgroundColorDark \"#1b1619\"",
    "deploy:antigua": "firebase deploy --only hosting:antigua"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "firebase": "^13.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@capacitor-firebase/authentication": {
      "firebase": "$firebase"
    }
  }
}
