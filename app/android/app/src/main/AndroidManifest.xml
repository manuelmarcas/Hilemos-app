<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Los enlaces de las votaciones (https://hilemos.web.app/#/v/<id>) abren la app si está instalada.
                 Android lo verifica con /.well-known/assetlinks.json en la web (ver «App de Android» en README.md). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="hilemos.web.app" />
            </intent-filter>
        </activity>

        <!-- Avisos (Firebase Cloud Messaging, plugin @capacitor/push-notifications): icono pequeño, color y canal por
             defecto. El canal «avisos» lo crea la app al activarlos (app/src/lib/push.ts) y las Cloud Functions lo
             usan al mandarlos (functions/index.js). -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_hilemos" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/hilemos_brand" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="avisos" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
