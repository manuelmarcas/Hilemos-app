rules_version = '2';

// Reglas para la app de Votaciones.
// Publícalas en Firebase Console > Firestore Database > Reglas (o con `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Entró sin cuenta (sesión anónima): puede crear votaciones y participar en las abiertas, pero no entrar
    // en las restringidas (con aprobación o solo con correos), que necesitan saber quién es.
    // También quien entra con su clave de acceso: la app la guarda como una cuenta interna de correo y contraseña
    // con un correo ficticio de @clave.hilemos.web.app (ver app/src/lib/store/accessKey.ts).
    function anon() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        || request.auth.token.get('email', '').matches('.*@clave[.]hilemos[.]web[.]app$');
    }

    function pollData(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data;
    }

    // Administra la votación: el creador (ownerUid) o alguien que él ha nombrado administrador (admins).
    function isAdminOf(p) {
      return p.ownerUid == request.auth.uid || request.auth.uid in p.get('admins', []);
    }

    // ---------- Votación original de Navidad (index.html del repo "votaciones") ----------
    // Se mantiene para no romperla. Si tus reglas actuales de /votes son distintas, conserva las tuyas.
    match /votes/{uid} {
      allow read: if signedIn() && !anon();
      allow write: if signedIn() && !anon() && request.auth.uid == uid;
    }

    // ---------- Votaciones ----------
    match /polls/{pollId} {
      function pollPath() {
        return /databases/$(database)/documents/polls/$(pollId);
      }
      function myVotePath() {
        return /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      }

      // Cualquiera con sesión iniciada puede abrir una votación si tiene el enlace
      // (para saber si puede entrar). Los votos de las restringidas se protegen abajo.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.type in ['hours', 'days', 'weeks', 'months', 'options']
        && validShape(request.resource.data)
        && (!('anonymous' in request.resource.data) || request.resource.data.anonymous is bool)
        && (!('approval' in request.resource.data) || request.resource.data.approval is bool)
        && (!('emailsOnly' in request.resource.data) || request.resource.data.emailsOnly is bool)
        // Tope de personas (las votaciones antiguas no lo tienen): entre 2 y 150, y el contador empieza en 0.
        && (!('maxPeople' in request.resource.data)
            || (request.resource.data.maxPeople is int
                && request.resource.data.maxPeople >= 2
                && request.resource.data.maxPeople <= 150
                && request.resource.data.get('members', -1) == 0))
        && (!('members' in request.resource.data) || 'maxPeople' in request.resource.data)
        && request.resource.data.closed == false;

      allow update: if signedIn() && (ownerUpdate() || leaveAdmins() || joinCount() || leaveCount());

      // Qué se vota: casillas y opciones. Las de días tienen como mucho 4 opciones por día; las de opciones libres
      // («options»), de 2 a 30, y sus casillas son esas mismas opciones.
      function validShape(d) {
        return d.slots is list && d.slots.size() > 0 && d.slots.size() <= 400
          && d.options is list
          && (d.type == 'options'
              ? d.options.size() >= 2 && d.options.size() <= 30 && d.slots.size() == d.options.size()
              : d.options.size() <= 4)
          && (!('months' in d) || (d.months is list && d.months.size() <= 60));
      }

      // Los administradores (creador y nombrados) pueden cerrar/reabrir, editarla (título, descripción y, sin
      // desempate, lo que se vota; nunca el tipo), hacerla anónima (nunca al revés, para no destapar votos hechos
      // como anónimos), el desempate y su aviso (tbNote), el plazo para votar, el tope de personas y el contador (al
      // aceptar o rechazar solicitudes). Solo el creador cambia su nombre visible, nombra o quita administradores y
      // pasa la votación a otra persona (al salir de ella o eliminar su cuenta).
      // Al editar, la app no deja quitar lo que ya tiene votos (las reglas no pueden leer todos los votos).
      function ownerUpdate() {
        let d = request.resource.data;
        let old = resource.data;
        let keys = d.diff(old).affectedKeys();
        let creator = old.ownerUid == request.auth.uid;
        return isAdminOf(old)
          && keys.hasOnly(['closed', 'title', 'description', 'ownerName', 'anonymous', 'tiebreak', 'tbNote', 'maxPeople', 'members', 'deadline', 'admins', 'ownerUid', 'founder', 'founderName',
                           'months', 'slots', 'hours', 'hourStep', 'hoursByDay', 'options'])
          && (!keys.hasAny(['title']) || (d.title is string && d.title.size() > 0 && d.title.size() <= 120))
          && (!keys.hasAny(['description']) || (d.description is string && d.description.size() <= 300))
          // Lo que se vota solo cambia sin desempate (ni abierto ni finalizado): el recuento ya estaría hecho.
          && (!keys.hasAny(['months', 'slots', 'hours', 'hourStep', 'hoursByDay', 'options'])
              || (old.get('tiebreak', null) == null && validShape(d)))
          // Desempate finalizado: el resultado es definitivo. La votación ya no se reabre ni el desempate se quita;
          // si terminó sin ganadora, solo se puede repetir entre sus mismas opciones.
          && (old.get('tiebreak', null) == null || old.tiebreak.get('done', false) == false
              || (!keys.hasAny(['closed'])
                  && (!keys.hasAny(['tiebreak'])
                      || (d.tiebreak != null && d.tiebreak.get('done', false) == false
                          && d.tiebreak.candidates.hasOnly(old.tiebreak.candidates)))))
          && (!keys.hasAny(['ownerName', 'admins', 'ownerUid', 'founder', 'founderName']) || creator)
          // El creador original (founder) solo se apunta al pasar la votación, y una vez.
          && (!keys.hasAny(['founder', 'founderName'])
              || (keys.hasAny(['ownerUid']) && !('founder' in old) && d.founder == request.auth.uid
                  && d.founderName is string && d.founderName.size() <= 100))
          && (!keys.hasAny(['admins']) || (d.admins is list && d.admins.size() <= 20 && !(d.ownerUid in d.admins)))
          // Pasar la votación: a alguien aceptado (con su voto, sin estado y que no se haya ido), no a uno mismo.
          && (!keys.hasAny(['ownerUid'])
              || (d.ownerUid is string && d.ownerUid != request.auth.uid
                  && exists(/databases/$(database)/documents/polls/$(pollId)/votes/$(d.ownerUid))
                  && get(/databases/$(database)/documents/polls/$(pollId)/votes/$(d.ownerUid)).data.get('status', null) == null
                  && get(/databases/$(database)/documents/polls/$(pollId)/votes/$(d.ownerUid)).data.get('gone', false) == false))
          && (!keys.hasAny(['deadline']) || (d.deadline is int && d.deadline >= 0))
          && (!keys.hasAny(['anonymous']) || d.anonymous == true)
          && (!keys.hasAny(['tiebreak'])
              || d.tiebreak == null
              || (d.tiebreak.id is number
                  && d.tiebreak.candidates is list
                  && d.tiebreak.candidates.size() >= 2
                  && d.tiebreak.candidates.size() <= 50))
          // Aviso para todos de que el desempate cambió porque alguien dejó de participar (o null al quitarlo).
          && (!keys.hasAny(['tbNote'])
              || d.tbNote == null
              || (d.tbNote is map
                  && d.tbNote.keys().hasOnly(['at', 'solved', 'tb', 'n'])
                  && d.tbNote.at is int
                  && d.tbNote.solved is bool))
          && (!keys.hasAny(['maxPeople', 'members'])
              || ('maxPeople' in resource.data
                  && d.maxPeople is int && d.maxPeople >= 2 && d.maxPeople <= 150
                  && d.members is int && d.members >= 0 && d.members <= d.maxPeople));
      }

      // Un administrador nombrado puede dejar de serlo (lo hace la app al eliminar su cuenta).
      function leaveAdmins() {
        let old = resource.data;
        return request.auth.uid in old.get('admins', [])
          && request.resource.data.diff(old).affectedKeys().hasOnly(['admins'])
          && request.resource.data.admins == old.admins.removeAll([request.auth.uid]);
      }

      // Cualquiera puede sumar 1 al contador al entrar (a la vez que crea su voto) y restar 1 al salir.
      function counterOnly() {
        return 'maxPeople' in resource.data
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
      }
      function joinCount() {
        return counterOnly()
          && request.resource.data.members == resource.data.get('members', 0) + 1
          && request.resource.data.members <= resource.data.maxPeople
          && !exists(myVotePath())
          && existsAfter(myVotePath());
      }
      function leaveCount() {
        return counterOnly()
          && request.resource.data.members == resource.data.get('members', 0) - 1
          && exists(myVotePath())
          && !existsAfter(myVotePath());
      }

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Correos permitidos de una votación privada: solo los ven y cambian el creador y los administradores.
      match /private/{doc} {
        allow read: if signedIn() && isAdminOf(pollData(pollId));
        allow create: if signedIn() && getAfter(pollPath()).data.ownerUid == request.auth.uid && validAccess();
        allow update: if signedIn() && isAdminOf(pollData(pollId)) && validAccess();
        allow delete: if signedIn() && pollData(pollId).ownerUid == request.auth.uid;

        function validAccess() {
          return doc == 'access'
            && request.resource.data.keys().hasOnly(['emails'])
            && request.resource.data.emails is list
            && request.resource.data.emails.size() <= 150;
        }
      }

      // Votaciones solo con correos: con qué correo entró cada participante. Lo apunta cada uno (el de su cuenta,
      // verificado) y solo lo leen quienes la administran: así, quitar un correo de la lista expulsa a quien lo usó.
      // No va en el voto porque los votos los leen todos los participantes.
      match /emails/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdminOf(pollData(pollId)));
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && pollData(pollId).get('emailsOnly', false) == true
          && request.resource.data.keys().hasOnly(['email'])
          && request.auth.token.email_verified == true
          && request.resource.data.email == request.auth.token.email.lower();
        allow delete: if signedIn() && (request.auth.uid == uid || pollData(pollId).ownerUid == request.auth.uid);
      }

      // Chat de la votación: un documento por mensaje. Solo el creador y los participantes aceptados;
      // quien está pendiente o rechazado no entra. Los mensajes no se editan ni se borran.
      // Los mensajes de antes de que alguien entrara (votes.joinedAt) no son para él: solo el creador lee todos. La
      // app los pide siempre «desde» (where at >= joinedAt), que es lo que Firestore necesita para aceptar la consulta.
      // Sin joinedAt (votos de antes de guardarlo), desde 0: todos.
      match /chat/{msgId} {
        allow read: if signedIn() && chatMember() && sinceJoined();
        allow create: if signedIn() && chatMember() && validMsg();
        allow update: if signedIn() && (ownName() || adminHides());

        // Solo el nombre de los mensajes propios: al salir de la votación (o eliminar la cuenta) pasan a un nombre
        // sin dueño. La app lo hace antes de borrar su voto, mientras aún es chatMember() para poder leerlos.
        function ownName() {
          return resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 100;
        }

        // Quien administra la votación oculta un mensaje (hidden: true) o lo vuelve a mostrar (sin el campo).
        function adminHides() {
          return isAdminOf(pollData(pollId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
            && (!('hidden' in request.resource.data) || request.resource.data.hidden == true);
        }

        function sinceJoined() {
          return pollData(pollId).ownerUid == request.auth.uid
            || resource.data.at >= get(myVotePath()).data.get('joinedAt', 0);
        }

        function chatMember() {
          return pollData(pollId).ownerUid == request.auth.uid
            || (exists(myVotePath()) && get(myVotePath()).data.get('status', null) == null);
        }

        // `sys`: aviso de un cambio en la votación, que solo escribe quien la administra (al editarla).
        function validMsg() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'name', 'text', 'at', 'sys'])
            && (!('sys' in d) || (d.sys == true && isAdminOf(pollData(pollId))))
            && d.uid == request.auth.uid
            && d.name is string && d.name.size() > 0 && d.name.size() <= 100
            && d.text is string && d.text.size() > 0 && d.text.size() <= 500
            && d.at is int;
        }
      }

      // Denuncias de mensajes del chat: una por persona y mensaje ({msgId}_{uid}), de un mensaje ajeno que no sea un
      // aviso y con su texto tal cual. Las leen quienes administran la votación (y las recibe quien modera Hilemos,
      // con una Cloud Function); no se cambian. El creador las borra al eliminar la votación.
      match /reports/{reportId} {
        allow read: if signedIn() && isAdminOf(pollData(pollId));
        allow create: if signedIn() && validReport();
        allow delete: if signedIn() && pollData(pollId).ownerUid == request.auth.uid;

        function validReport() {
          let d = request.resource.data;
          let msg = get(/databases/$(database)/documents/polls/$(pollId)/chat/$(d.msgId)).data;
          return d.keys().hasOnly(['msgId', 'msgUid', 'msgName', 'msgText', 'by', 'byName', 'reason', 'comment', 'at'])
            && d.msgId is string
            && reportId == d.msgId + '_' + request.auth.uid
            && d.by == request.auth.uid
            && d.msgUid == msg.uid && d.msgUid != request.auth.uid
            && d.msgText == msg.text
            && msg.get('sys', false) == false
            && d.msgName is string && d.msgName.size() <= 100
            && d.byName is string && d.byName.size() <= 100
            && d.reason in ['ofensivo', 'spam', 'inapropiado', 'otro']
            && (!('comment' in d) || (d.comment is string && d.comment.size() <= 300))
            && d.at is int
            && (pollData(pollId).ownerUid == request.auth.uid
                || (exists(myVotePath()) && get(myVotePath()).data.get('status', null) == null));
        }
      }

      // Participantes: un documento por persona (su id es su uid).
      match /votes/{uid} {
        // En las votaciones restringidas (con aprobación o solo con correos), los votos solo los ven el creador
        // y los participantes aceptados; quien está pendiente solo puede leer su propio documento.
        allow get: if signedIn() && (request.auth.uid == uid || canSeeVotes());
        allow list: if signedIn() && canSeeVotes();

        function canSeeVotes() {
          let p = pollData(pollId);
          return !(p.get('approval', false) || p.get('emailsOnly', false))
            || isAdminOf(p)
            || (exists(myVotePath()) && get(myVotePath()).data.get('status', null) == null);
        }

        // Entrar. Con la votación cerrada se puede entrar como participante, pero no votar.
        allow create: if signedIn()
          && request.auth.uid == uid
          && validVote()
          && validTiebreakVote(null)
          && (pollData(pollId).get('closed', false) == false || !('picks' in request.resource.data))
          && canJoin()
          && countedJoin();

        // Quién puede entrar: el creador siempre; si es privada, solo los correos permitidos (cuenta verificada);
        // si es con aprobación, se entra como pendiente; sin cuenta, solo en las abiertas.
        function canJoin() {
          let p = pollData(pollId);
          let d = request.resource.data;
          return (p.ownerUid == request.auth.uid && !('status' in d))
            || ((!anon() || !(p.get('approval', false) || p.get('emailsOnly', false)))
                && (!p.get('emailsOnly', false)
                    || (request.auth.token.email_verified == true
                        && request.auth.token.email.lower()
                           in get(/databases/$(database)/documents/polls/$(pollId)/private/access).data.emails))
                && (p.get('approval', false) ? d.get('status', null) == 'pending' : !('status' in d)));
        }

        // Con tope, el contador de la votación tiene que subir 1 en la misma escritura (y no pasar del tope).
        function countedJoin() {
          let p = pollData(pollId);
          return !('maxPeople' in p)
            || (getAfter(pollPath()).data.members == p.get('members', 0) + 1
                && getAfter(pollPath()).data.members <= p.maxPeople);
        }

        allow update: if signedIn() && (selfUpdate() || ownerSetsStatus());

        // Cada uno cambia su nombre, foto y votos, pero no su estado (ni si le expulsaron); pendiente o rechazado no puede votar.
        function selfUpdate() {
          let d = request.resource.data;
          let old = resource.data;
          return request.auth.uid == uid
            && validVote()
            && validTiebreakVote(old.get('tb', null))
            && (pollData(pollId).get('closed', false) == false || d.get('picks', []) == old.get('picks', []))
            && d.get('status', null) == old.get('status', null)
            && d.get('removed', false) == old.get('removed', false)
            && d.get('joinedAt', null) == old.get('joinedAt', null)
            && (old.get('status', null) == null
                || (d.get('picks', []) == old.get('picks', []) && d.get('tb', null) == old.get('tb', null)));
        }

        // Un administrador acepta (quita el estado y le abre el chat desde ahora), rechaza o vuelve a dejar pendiente a otra persona
        // (nunca al creador). Expulsar a alguien de la votación es rechazarle con `removed`; a otro administrador solo
        // le expulsa el creador.
        function ownerSetsStatus() {
          let d = request.resource.data;
          let p = pollData(pollId);
          return isAdminOf(p)
            && request.auth.uid != uid
            && uid != p.ownerUid
            && (!(uid in p.get('admins', [])) || p.ownerUid == request.auth.uid)
            && d.diff(resource.data).affectedKeys().hasOnly(['status', 'removed', 'joinedAt', 'picks', 'tb'])
            // Sus votos solo se pueden borrar (nunca cambiar): al expulsarle o al readmitir a quien estaba rechazado.
            && (!d.diff(resource.data).affectedKeys().hasAny(['picks', 'tb'])
                || (!('picks' in d) && !('tb' in d)
                    && ((d.get('status', null) == 'rejected' && d.get('removed', false) == true)
                        || (!('status' in d) && resource.data.get('status', null) == 'rejected'))))
            && (!('status' in d) || d.status in ['pending', 'rejected'])
            // Al aceptar o readmitir (sin estado), el chat se le abre desde ese momento: joinedAt pasa a ser ahora
            // (con margen por el reloj del móvil) y nunca hacia atrás, para no destapar lo de mientras estaba fuera.
            && (d.get('joinedAt', null) == resource.data.get('joinedAt', null)
                || (!('status' in d)
                    && d.joinedAt is int
                    && d.joinedAt >= resource.data.get('joinedAt', 0)
                    && d.joinedAt > request.time.toMillis() - 600000
                    && d.joinedAt < request.time.toMillis() + 600000))
            && (!('removed' in d) || (d.removed == true && d.get('status', null) == 'rejected'));
        }

        // Cada uno puede salir (restando 1 al contador si lo hay), salvo si le han rechazado;
        // el creador puede borrar todas (al eliminar la votación).
        allow delete: if signedIn()
          && ((request.auth.uid == uid
               && resource.data.get('status', null) != 'rejected'
               && (!('maxPeople' in pollData(pollId))
                   || getAfter(pollPath()).data.members == pollData(pollId).get('members', 0) - 1))
              || pollData(pollId).ownerUid == request.auth.uid);

        function validVote() {
          let d = request.resource.data;
          return d.name is string
            && d.name.size() <= 100
            && (!('photo' in d) || (d.photo is string && d.photo.size() <= 150000))
            && (!('picks' in d) || (d.picks is list && d.picks.size() <= 3000))
            // Cuándo entró (desde entonces ve el chat). Lo pone la app al entrar y luego no cambia.
            && (!('joinedAt' in d) || d.joinedAt is int);
        }

        // Desempate: un solo voto ({ id, pick }) a una opción candidata y solo mientras esté abierto.
        function validTiebreakVote(old) {
          let tb = request.resource.data.get('tb', null);
          let p = pollData(pollId);
          return tb == old || (
            p.get('tiebreak', null) != null
            && p.tiebreak.get('done', false) == false
            && (tb == null
                || (tb is map && tb.id == p.tiebreak.id && tb.pick is string && tb.pick in p.tiebreak.candidates)));
        }
      }
    }

    // ---------- Datos privados de cada usuario: perfil (users/{uid}), sus votaciones y sus grupos ----------
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
