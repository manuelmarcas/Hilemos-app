rules_version = '2';

// Reglas para la app de Votaciones.
// Publícalas en Firebase Console > Firestore Database > Reglas (o con `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Entró sin cuenta (sesión anónima): puede crear votaciones y participar en las abiertas, pero no entrar
    // en las restringidas (con aprobación o solo con correos), que necesitan saber quién es.
    // También quien entra con su clave de acceso: la app la guarda como una cuenta interna de correo y contraseña
    // con un correo ficticio de @clave.hilemos.web.app (ver app/src/lib/store.ts).
    function anon() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous'
        || request.auth.token.get('email', '').matches('.*@clave[.]hilemos[.]web[.]app$');
    }

    function pollData(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId)).data;
    }

    // Administra la votación: el creador (ownerUid) o alguien que él ha nombrado administrador (admins).
    function isAdminOf(p) {
      return p.ownerUid == request.auth.uid || request.auth.uid in p.get('admins', []);
    }

    // ---------- Votación original de Navidad (index.html del repo "votaciones") ----------
    // Se mantiene para no romperla. Si tus reglas actuales de /votes son distintas, conserva las tuyas.
    match /votes/{uid} {
      allow read: if signedIn() && !anon();
      allow write: if signedIn() && !anon() && request.auth.uid == uid;
    }

    // ---------- Votaciones ----------
    match /polls/{pollId} {
      function pollPath() {
        return /databases/$(database)/documents/polls/$(pollId);
      }
      function myVotePath() {
        return /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      }

      // Cualquiera con sesión iniciada puede abrir una votación si tiene el enlace
      // (para saber si puede entrar). Los votos de las restringidas se protegen abajo.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.type in ['hours', 'days', 'weeks', 'months']
        && request.resource.data.slots is list
        && request.resource.data.slots.size() > 0
        && request.resource.data.slots.size() <= 400
        && request.resource.data.options is list
        && request.resource.data.options.size() <= 4
        && (!('anonymous' in request.resource.data) || request.resource.data.anonymous is bool)
        && (!('approval' in request.resource.data) || request.resource.data.approval is bool)
        && (!('emailsOnly' in request.resource.data) || request.resource.data.emailsOnly is bool)
        // Tope de personas (las votaciones antiguas no lo tienen): entre 2 y 150, y el contador empieza en 0.
        && (!('maxPeople' in request.resource.data)
            || (request.resource.data.maxPeople is int
                && request.resource.data.maxPeople >= 2
                && request.resource.data.maxPeople <= 150
                && request.resource.data.get('members', -1) == 0))
        && (!('members' in request.resource.data) || 'maxPeople' in request.resource.data)
        && request.resource.data.closed == false;

      allow update: if signedIn() && (ownerUpdate() || leaveAdmins() || joinCount() || leaveCount());

      // Los administradores (creador y nombrados) pueden cerrar/reabrir, cambiar título o descripción, hacerla
      // anónima (nunca al revés, para no destapar votos hechos como anónimos), el desempate, el plazo para votar,
      // el tope de personas y el contador (al aceptar o rechazar solicitudes). Solo el creador cambia su nombre
      // visible, nombra o quita administradores y pasa la votación a otra persona (al eliminar su cuenta).
      function ownerUpdate() {
        let d = request.resource.data;
        let old = resource.data;
        let keys = d.diff(old).affectedKeys();
        let creator = old.ownerUid == request.auth.uid;
        return isAdminOf(old)
          && keys.hasOnly(['closed', 'title', 'description', 'ownerName', 'anonymous', 'tiebreak', 'maxPeople', 'members', 'deadline', 'admins', 'ownerUid'])
          && (!keys.hasAny(['ownerName', 'admins', 'ownerUid']) || creator)
          && (!keys.hasAny(['admins']) || (d.admins is list && d.admins.size() <= 20 && !(d.ownerUid in d.admins)))
          // Pasar la votación: a alguien aceptado (con su voto y sin estado), no a uno mismo.
          && (!keys.hasAny(['ownerUid'])
              || (d.ownerUid is string && d.ownerUid != request.auth.uid
                  && exists(/databases/$(database)/documents/polls/$(pollId)/votes/$(d.ownerUid))
                  && get(/databases/$(database)/documents/polls/$(pollId)/votes/$(d.ownerUid)).data.get('status', null) == null))
          && (!keys.hasAny(['deadline']) || (d.deadline is int && d.deadline >= 0))
          && (!keys.hasAny(['anonymous']) || d.anonymous == true)
          && (!keys.hasAny(['tiebreak'])
              || d.tiebreak == null
              || (d.tiebreak.id is number
                  && d.tiebreak.candidates is list
                  && d.tiebreak.candidates.size() >= 2
                  && d.tiebreak.candidates.size() <= 50))
          && (!keys.hasAny(['maxPeople', 'members'])
              || ('maxPeople' in resource.data
                  && d.maxPeople is int && d.maxPeople >= 2 && d.maxPeople <= 150
                  && d.members is int && d.members >= 0 && d.members <= d.maxPeople));
      }

      // Un administrador nombrado puede dejar de serlo (lo hace la app al eliminar su cuenta).
      function leaveAdmins() {
        let old = resource.data;
        return request.auth.uid in old.get('admins', [])
          && request.resource.data.diff(old).affectedKeys().hasOnly(['admins'])
          && request.resource.data.admins == old.admins.removeAll([request.auth.uid]);
      }

      // Cualquiera puede sumar 1 al contador al entrar (a la vez que crea su voto) y restar 1 al salir.
      function counterOnly() {
        return 'maxPeople' in resource.data
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
      }
      function joinCount() {
        return counterOnly()
          && request.resource.data.members == resource.data.get('members', 0) + 1
          && request.resource.data.members <= resource.data.maxPeople
          && !exists(myVotePath())
          && existsAfter(myVotePath());
      }
      function leaveCount() {
        return counterOnly()
          && request.resource.data.members == resource.data.get('members', 0) - 1
          && exists(myVotePath())
          && !existsAfter(myVotePath());
      }

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Correos permitidos de una votación privada: solo los ven y cambian el creador y los administradores.
      match /private/{doc} {
        allow read: if signedIn() && isAdminOf(pollData(pollId));
        allow create: if signedIn() && getAfter(pollPath()).data.ownerUid == request.auth.uid && validAccess();
        allow update: if signedIn() && isAdminOf(pollData(pollId)) && validAccess();
        allow delete: if signedIn() && pollData(pollId).ownerUid == request.auth.uid;

        function validAccess() {
          return doc == 'access'
            && request.resource.data.keys().hasOnly(['emails'])
            && request.resource.data.emails is list
            && request.resource.data.emails.size() <= 150;
        }
      }

      // Chat de la votación: un documento por mensaje. Solo el creador y los participantes aceptados;
      // quien está pendiente o rechazado no entra. Ni update ni delete: los mensajes no se editan ni se borran.
      match /chat/{msgId} {
        allow read: if signedIn() && chatMember();
        allow create: if signedIn() && chatMember() && validMsg();
        // Solo el nombre de los mensajes propios (al eliminar la cuenta pasan a un nombre sin dueño).
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;

        function chatMember() {
          return pollData(pollId).ownerUid == request.auth.uid
            || (exists(myVotePath()) && get(myVotePath()).data.get('status', null) == null);
        }

        function validMsg() {
          let d = request.resource.data;
          return d.keys().hasOnly(['uid', 'name', 'text', 'at'])
            && d.uid == request.auth.uid
            && d.name is string && d.name.size() > 0 && d.name.size() <= 100
            && d.text is string && d.text.size() > 0 && d.text.size() <= 500
            && d.at is int;
        }
      }

      // Participantes: un documento por persona (su id es su uid).
      match /votes/{uid} {
        // En las votaciones restringidas (con aprobación o solo con correos), los votos solo los ven el creador
        // y los participantes aceptados; quien está pendiente solo puede leer su propio documento.
        allow get: if signedIn() && (request.auth.uid == uid || canSeeVotes());
        allow list: if signedIn() && canSeeVotes();

        function canSeeVotes() {
          let p = pollData(pollId);
          return !(p.get('approval', false) || p.get('emailsOnly', false))
            || isAdminOf(p)
            || (exists(myVotePath()) && get(myVotePath()).data.get('status', null) == null);
        }

        // Entrar. Con la votación cerrada se puede entrar como participante, pero no votar.
        allow create: if signedIn()
          && request.auth.uid == uid
          && validVote()
          && validTiebreakVote(null)
          && (pollData(pollId).get('closed', false) == false || !('picks' in request.resource.data))
          && canJoin()
          && countedJoin();

        // Quién puede entrar: el creador siempre; si es privada, solo los correos permitidos (cuenta verificada);
        // si es con aprobación, se entra como pendiente; sin cuenta, solo en las abiertas.
        function canJoin() {
          let p = pollData(pollId);
          let d = request.resource.data;
          return (p.ownerUid == request.auth.uid && !('status' in d))
            || ((!anon() || !(p.get('approval', false) || p.get('emailsOnly', false)))
                && (!p.get('emailsOnly', false)
                    || (request.auth.token.email_verified == true
                        && request.auth.token.email.lower()
                           in get(/databases/$(database)/documents/polls/$(pollId)/private/access).data.emails))
                && (p.get('approval', false) ? d.get('status', null) == 'pending' : !('status' in d)));
        }

        // Con tope, el contador de la votación tiene que subir 1 en la misma escritura (y no pasar del tope).
        function countedJoin() {
          let p = pollData(pollId);
          return !('maxPeople' in p)
            || (getAfter(pollPath()).data.members == p.get('members', 0) + 1
                && getAfter(pollPath()).data.members <= p.maxPeople);
        }

        allow update: if signedIn() && (selfUpdate() || ownerSetsStatus());

        // Cada uno cambia su nombre, foto y votos, pero no su estado; pendiente o rechazado no puede votar.
        function selfUpdate() {
          let d = request.resource.data;
          let old = resource.data;
          return request.auth.uid == uid
            && validVote()
            && validTiebreakVote(old.get('tb', null))
            && (pollData(pollId).get('closed', false) == false || d.get('picks', []) == old.get('picks', []))
            && d.get('status', null) == old.get('status', null)
            && (old.get('status', null) == null
                || (d.get('picks', []) == old.get('picks', []) && d.get('tb', null) == old.get('tb', null)));
        }

        // Un administrador acepta (quita el estado), rechaza o vuelve a dejar pendiente a otra persona
        // (nunca al creador).
        function ownerSetsStatus() {
          let d = request.resource.data;
          let p = pollData(pollId);
          return isAdminOf(p)
            && request.auth.uid != uid
            && uid != p.ownerUid
            && d.diff(resource.data).affectedKeys().hasOnly(['status'])
            && (!('status' in d) || d.status in ['pending', 'rejected']);
        }

        // Cada uno puede salir (restando 1 al contador si lo hay), salvo si le han rechazado;
        // el creador puede borrar todas (al eliminar la votación).
        allow delete: if signedIn()
          && ((request.auth.uid == uid
               && resource.data.get('status', null) != 'rejected'
               && (!('maxPeople' in pollData(pollId))
                   || getAfter(pollPath()).data.members == pollData(pollId).get('members', 0) - 1))
              || pollData(pollId).ownerUid == request.auth.uid);

        function validVote() {
          let d = request.resource.data;
          return d.name is string
            && d.name.size() <= 100
            && (!('photo' in d) || (d.photo is string && d.photo.size() <= 150000))
            && (!('picks' in d) || (d.picks is list && d.picks.size() <= 3000));
        }

        // Desempate: un solo voto ({ id, pick }) a una opción candidata y solo mientras esté abierto.
        function validTiebreakVote(old) {
          let tb = request.resource.data.get('tb', null);
          let p = pollData(pollId);
          return tb == old || (
            p.get('tiebreak', null) != null
            && p.tiebreak.get('done', false) == false
            && (tb == null
                || (tb is map && tb.id == p.tiebreak.id && tb.pick is string && tb.pick in p.tiebreak.candidates)));
        }
      }
    }

    // ---------- Datos privados de cada usuario: perfil (users/{uid}), sus votaciones y sus grupos ----------
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
